# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/shunyigarments?retryWrites=true&w=majority
MONGODB_DATABASE=shunyigarments

# Admin authentication
ADMIN_EMAIL=admin@example.com
# Generate with: node scripts/hash-password.js "your-strong-password"
ADMIN_PASSWORD_HASH=<salt>:<64-byte-scrypt-hash>
# Generate a random secret of at least 32 characters
SESSION_SECRET=<long-random-secret-at-least-32-characters>
